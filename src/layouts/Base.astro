---
import { url } from '../lib/logs';
interface Props { title?: string; description?: string }
const { title, description = 'AI와 함께 바이브코딩으로 만든 것들의 기록' } = Astro.props;
const siteName = 'Vibe Log';
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={url('favicon.svg')} />
    <script is:inline>
      // 화면이 그려지기 전에 테마를 정해서 깜빡임을 막아요: 저장된 선택 → 시스템 설정 순
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = t;
      })();
    </script>
  </head>
  <body>
    <header class="wrap top">
      <a class="brand" href={url('/')}>{siteName}</a>
      <nav>
        <a href={url('/')}>기록</a><a href={url('tags')}>태그</a>
        <button id="theme-toggle" class="theme-btn" type="button" aria-label="다크모드 전환">
          <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" fill="currentColor"/></svg>
          <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="currentColor"/><g stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8"/></g></svg>
        </button>
      </nav>
    </header>
    <script is:inline>
      document.getElementById('theme-toggle').addEventListener('click', () => {
        const root = document.documentElement;
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch (e) {}
      });
    </script>
    <main class="wrap"><slot /></main>
    <footer class="wrap foot">© {new Date().getFullYear()} Riyunna You</footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #fbfaf7; --fg: #1d1d1b; --muted: #6b6a65; --line: #e6e3dc;
    --accent: #2f6f4f; --accent-soft: #e3efe8; --chip: #f0eee8;
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, 'Apple SD Gothic Neo', 'Malgun Gothic', sans-serif;
  }
  :root { color-scheme: light; }
  :root[data-theme='dark'] {
    color-scheme: dark;
    --bg: #151614; --fg: #ecebe6; --muted: #9a998f; --line: #2b2c29;
    --accent: #7cc39c; --accent-soft: #1f2e26; --chip: #23241f;
  }
  body { transition: background-color 0.2s, color 0.2s; }
  nav { display: flex; align-items: center; }
  .theme-btn { margin-left: 16px; width: 32px; height: 32px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 8px; background: transparent; color: var(--muted); cursor: pointer; }
  .theme-btn:hover { color: var(--fg); border-color: var(--muted); }
  .theme-btn .i-sun { display: none; }
  :root[data-theme='dark'] .theme-btn .i-sun { display: block; }
  :root[data-theme='dark'] .theme-btn .i-moon { display: none; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); line-height: 1.7; }
  a { color: inherit; }
  .wrap { max-width: 720px; margin: 0 auto; padding: 0 20px; }
  .top { display: flex; justify-content: space-between; align-items: center; padding-top: 28px; padding-bottom: 28px; }
  .brand { font-weight: 700; text-decoration: none; letter-spacing: -0.02em; }
  nav a { margin-left: 18px; color: var(--muted); text-decoration: none; font-size: 0.95rem; }
  nav a:hover { color: var(--fg); }
  .foot { color: var(--muted); font-size: 0.85rem; padding-top: 48px; padding-bottom: 40px; }
  .chip { display: inline-block; font-size: 0.78rem; padding: 2px 9px; border-radius: 999px;
    background: var(--chip); color: var(--muted); text-decoration: none; margin: 0 4px 4px 0; }
  .chip:hover { color: var(--fg); }
  code { background: var(--chip); padding: 1px 5px; border-radius: 4px; font-size: 0.9em; }
  pre { background: var(--chip); padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
  pre code { background: none; padding: 0; }
</style>
